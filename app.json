{
  "expo": {
    "name": "MD App",
    "slug": "md-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "mailer-daemon",
    "icon": "./assets/md_logo.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "appmailerdaemon",
      "mdapp"
    ],
    "associatedDomains": [
      "applinks:appmailerdaemon.online"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.mdapp"
    },
    "android": {
      "targetSdkVersion": 35,
      "versionCode": 16,
      "package": "com.yourcompany.mdapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/md_logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "appmailerdaemon.online",
              "pathPrefix": "/post/.*"
            },
            {
              "scheme": "http",
              "host": "appmailerdaemon.online",
              "pathPrefix": "/post/.*"
            }
          ]
        }
      ]
    },
    "plugins": [
  [
    "react-native-google-mobile-ads",
    {
      "androidAppId": "ca-app-pub-9386844195611964~1740942446"
    }
  ],

  [
    "onesignal-expo-plugin",
    {
      "mode": "development"
    }
  ],

  "expo-image-picker",
  "expo-secure-store",

  [
    "expo-notifications",
    {
      "icon": "./assets/md_logo.png",
      "color": "#FF6600",
      "mode": "production"
    }
  ],

  [
    "expo-maps",
    {
      "requestLocationPermission": "true",
      "locationPermission": "Allow ${PRODUCT_NAME} to use your location"
    }
  ],

  [
    "expo-build-properties",
    {
      "android": {
        "kotlinVersion": "2.0.21"
      }
    }
  ],

  "expo-router",
  "expo-video"
],
    "extra": {
      "eas": {
        "projectId": "67ca0aa9-492d-41f1-bbdb-6f8c16d7b345"
      }
    }
  }
}
